<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="white">#FFFFFFFF</color>
    <string name="accessibility_service_description">AwakeWord需要无障碍服务来监听屏幕亮起事件，以便在锁屏界面显示单词卡片。本服务不会收集任何个人信息，仅用于检测屏幕状态。</string>
    <string name="app_name">AwakeWord</string>
    <string name="app_name_cn">醒词</string>
    <style name="Theme.WordDraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#6B4CE0</item>
        <item name="android:colorPrimaryDark">#5038B8</item>
        <item name="android:colorAccent">#FF9800</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.WordDraft.LockScreen" parent="Theme.WordDraft">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>