package com.worddraft.util

import android.util.Log
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.net.URL
import java.net.URLEncoder

/**
 * 词典查询结果
 */
data class DictResult(
    val phonetic: String,
    val meaning: String
)

/**
 * 词典API工具类
 * 使用免费词典API获取单词音标和中文意思
 */
object DictionaryApi {
    
    private const val TAG = "DictionaryApi"
    
    /**
     * 查询单词
     * 优先使用有道词典API，失败则返回空
     */
    suspend fun lookup(word: String): DictResult? = withContext(Dispatchers.IO) {
        try {
            // 方案1：使用有道词典 suggest API（快速，但有音标可能缺失）
            val result1 = tryYoudaoSuggest(word)
            if (result1 != null && result1.phonetic.isNotBlank()) {
                return@withContext result1
            }
            
            // 方案2：使用有道词典 jsonapi（更详细）
            val result2 = tryYoudaoJsonApi(word)
            if (result2 != null) {
                return@withContext result2
            }
            
            // 返回第一个结果（即使音标为空）
            result1
        } catch (e: Exception) {
            Log.e(TAG, "Lookup failed for word: $word", e)
            null
        }
    }
    
    /**
     * 有道词典 Suggest API
     */
    private fun tryYoudaoSuggest(word: String): DictResult? {
        return try {
            val encodedWord = URLEncoder.encode(word, "UTF-8")
            val url = "https://dict.youdao.com/suggest?num=1&doctype=json&q=$encodedWord"
            
            val response = URL(url).readText()
            parseYoudaoSuggestResponse(response, word)
        } catch (e: Exception) {
            Log.d(TAG, "Youdao suggest failed: ${e.message}")
            null
        }
    }
    
    /**
     * 有道词典 JSON API（更详细）
     */
    private fun tryYoudaoJsonApi(word: String): DictResult? {
        return try {
            val encodedWord = URLEncoder.encode(word, "UTF-8")
            val url = "https://dict.youdao.com/jsonapi?q=$encodedWord"
            
            val response = URL(url).readText()
            parseYoudaoJsonApiResponse(response, word)
        } catch (e: Exception) {
            Log.d(TAG, "Youdao jsonapi failed: ${e.message}")
            null
        }
    }
    
    /**
     * 解析有道词典 Suggest 响应
     */
    private fun parseYoudaoSuggestResponse(response: String, word: String): DictResult? {
        return try {
            val json = JSONObject(response)
            
            if (!json.has("data") || json.isNull("data")) {
                return null
            }
            
            val data = json.getJSONObject("data")
            
            if (!data.has("entries") || data.isNull("entries")) {
                return null
            }
            
            val entries = data.getJSONArray("entries")
            if (entries.length() == 0) {
                return null
            }
            
            val entry = entries.getJSONObject(0)
            val meaning = entry.optString("explain", "")
            val spelling = entry.optString("entry", "")
            
            // 从释义中提取音标
            val phonetic = extractPhoneticFromMeaning(meaning)
            
            DictResult(
                phonetic = phonetic,
                meaning = cleanMeaning(meaning)
            )
        } catch (e: Exception) {
            Log.e(TAG, "Parse suggest response failed", e)
            null
        }
    }
    
    /**
     * 解析有道词典 JSON API 响应（更详细）
     */
    private fun parseYoudaoJsonApiResponse(response: String, word: String): DictResult? {
        return try {
            val json = JSONObject(response)
            
            var phonetic = ""
            var meaning = ""
            
            // 尝试从 ec（英汉词典）获取
            if (json.has("ec") && !json.isNull("ec")) {
                val ec = json.getJSONObject("ec")
                if (ec.has("word") && !ec.isNull("word")) {
                    val wordData = ec.getJSONArray("word")
                    if (wordData.length() > 0) {
                        val wordInfo = wordData.getJSONObject(0)
                        
                        // 获取音标
                        wordInfo.optJSONObject("usphone")?.let { usPhone ->
                            phonetic = "/${usPhone.optString("phone", "")}/"
                        }
                        if (phonetic.isBlank()) {
                            val tr = wordInfo.optJSONArray("tr")?.optJSONObject(0)
                            tr?.let {
                                val l = it.optJSONArray("l")?.optJSONObject(0)
                                phonetic = l?.optString("usphone", "")?.let { p -> "/$p/" } ?: ""
                            }
                        }
                        
                        // 获取释义
                        val trs = wordInfo.optJSONArray("trs")
                        if (trs != null && trs.length() > 0) {
                            val meanings = mutableListOf<String>()
                            for (i in 0 until minOf(trs.length(), 3)) {
                                val trObj = trs.optJSONObject(i)
                                trObj?.optString("tr", "")?.let { meanings.add(it) }
                            }
                            meaning = meanings.joinToString("; ")
                        }
                    }
                }
            }
            
            // 尝试从 web_trans 获取（网络翻译）
            if (meaning.isBlank() && json.has("web_trans") && !json.isNull("web_trans")) {
                val webTrans = json.getJSONObject("web_trans")
                val trans = webTrans.optJSONArray("web-translation")
                if (trans != null && trans.length() > 0) {
                    val firstTrans = trans.optJSONObject(0)
                    firstTrans?.optJSONArray("trans")?.optJSONObject(0)?.let {
                        meaning = it.optString("value", "")
                    }
                }
            }
            
            // 尝试从 blng_sents_part 获取音标
            if (phonetic.isBlank() && json.has("blng_sents_part")) {
                val blng = json.optJSONObject("blng_sents_part")
                blng?.optJSONObject("word-pron")?.let { pron ->
                    val usPhone = pron.optString("usphone", "")
                    if (usPhone.isNotBlank()) {
                        phonetic = "/$usPhone/"
                    }
                }
            }
            
            if (meaning.isNotBlank() || phonetic.isNotBlank()) {
                DictResult(phonetic = phonetic, meaning = meaning)
            } else {
                null
            }
        } catch (e: Exception) {
            Log.e(TAG, "Parse jsonapi response failed", e)
            null
        }
    }
    
    /**
     * 从释义中提取音标
     */
    private fun extractPhoneticFromMeaning(meaning: String): String {
        // 尝试匹配音标格式，如 [ˈwɜːrd] 或 /wɜːrd/ 或 (ˈwɜːrd)
        val phoneticRegex = Regex("""\[([^\]]+)\]|/([^/]+)/|\(([^)]+)\)""")
        val match = phoneticRegex.find(meaning)
        return match?.let { 
            it.groupValues[1].ifEmpty { 
                it.groupValues[2].ifEmpty { 
                    it.groupValues[3] 
                } 
            }
        } ?: ""
    }
    
    /**
     * 清理释义文本
     */
    private fun cleanMeaning(meaning: String): String {
        // 移除音标部分
        var cleaned = meaning
            .replace(Regex("""\[[^\]]+\]"""), "")
            .replace(Regex("""/[^/]+/"""), "")
            .replace(Regex("""\([^)]+\)"""), "")
            .trim()
        
        // 如果包含中文，提取中文部分
        val chineseRegex = Regex("""[\u4e00-\u9fa5，。、；：！？""''（）【】《》\s]+""")
        val chineseMatch = chineseRegex.findAll(cleaned).joinToString("") { it.value }
        
        return chineseMatch.ifEmpty { cleaned }.trim()
    }
}