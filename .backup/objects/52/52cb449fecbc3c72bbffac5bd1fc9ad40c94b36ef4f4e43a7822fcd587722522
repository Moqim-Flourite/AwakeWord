package com.worddraft.util

import android.content.Context
import android.speech.tts.TextToSpeech
import android.speech.tts.UtteranceProgressListener
import android.util.Log
import java.util.*
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit

/**
 * TTS语音工具类
 * 使用同步初始化确保TTS正确加载
 */
object TtsManager {
    
    private const val TAG = "TtsManager"
    
    private var tts: TextToSpeech? = null
    @Volatile
    private var isInitialized = false
    @Volatile
    private var initFailed = false
    private var applicationContext: Context? = null
    private val initLock = Any()
    
    /**
     * 预初始化 - 在Application启动时调用，异步预热TTS引擎
     */
    fun preInit(context: Context) {
        Log.d(TAG, "preInit() called from Application")
        applicationContext = context.applicationContext
        
        // 异步初始化，不阻塞启动
        Thread {
            try {
                initInternal(context.applicationContext, null)
            } catch (e: Exception) {
                Log.e(TAG, "preInit failed: ${e.message}")
            }
        }.start()
    }
    
    /**
     * 初始化TTS - 使用同步等待确保初始化完成
     */
    @Synchronized
    fun init(context: Context, onReady: (() -> Unit)? = null) {
        applicationContext = context.applicationContext
        
        if (tts != null && isInitialized) {
            Log.d(TAG, "TTS already initialized")
            onReady?.invoke()
            return
        }
        
        // 如果之前初始化失败，先清理
        if (initFailed) {
            Log.d(TAG, "Previous init failed, retrying...")
            shutdown()
        }
        
        initInternal(context.applicationContext, onReady)
    }
    
    private fun initInternal(context: Context, onReady: (() -> Unit)?) {
        synchronized(initLock) {
            if (tts != null && isInitialized) {
                Log.d(TAG, "TTS already initialized in internal")
                onReady?.invoke()
                return
            }
            
            Log.d(TAG, "Creating new TTS instance...")
            
            val latch = CountDownLatch(1)
            var initResult = -1
            
            try {
                tts = TextToSpeech(context, object : TextToSpeech.OnInitListener {
                    override fun onInit(status: Int) {
                        initResult = status
                        Log.d(TAG, "TTS onInit called with status: $status")
                        latch.countDown()
                        
                        if (status == TextToSpeech.SUCCESS) {
                            setupLanguage()
                            isInitialized = true
                            initFailed = false
                            Log.d(TAG, "TTS initialized successfully")
                            onReady?.invoke()
                        } else {
                            Log.e(TAG, "TTS initialization failed with status: $status")
                            isInitialized = false
                            initFailed = true
                            // 延迟重试
                            retryInit(context, onReady)
                        }
                    }
                })
                
                // 等待初始化完成（最多5秒）
                val completed = latch.await(5, TimeUnit.SECONDS)
                if (!completed) {
                    Log.e(TAG, "TTS initialization timeout")
                    initFailed = true
                }
                
                Log.d(TAG, "initInternal completed: initResult=$initResult, isInitialized=$isInitialized")
            } catch (e: Exception) {
                Log.e(TAG, "Exception in initInternal: ${e.message}")
                initFailed = true
            }
        }
    }
    
    private fun retryInit(context: Context, onReady: (() -> Unit)?) {
        // 如果初始化失败，延迟2秒后重试
        Thread {
            try {
                Thread.sleep(2000)
                Log.d(TAG, "Retrying TTS initialization...")
                
                // 尝试获取默认引擎
                val engines = TextToSpeech(context, null).engines
                Log.d(TAG, "Available TTS engines: ${engines?.map { it.name }}")
                
                // 关闭临时实例
                TextToSpeech(context, null).shutdown()
                
                // 重新初始化
                synchronized(initLock) {
                    shutdown()
                    Thread.sleep(500)
                    
                    val latch = CountDownLatch(1)
                    tts = TextToSpeech(context, object : TextToSpeech.OnInitListener {
                        override fun onInit(status: Int) {
                            Log.d(TAG, "Retry onInit: status=$status")
                            latch.countDown()
                            
                            if (status == TextToSpeech.SUCCESS) {
                                setupLanguage()
                                isInitialized = true
                                initFailed = false
                                Log.d(TAG, "TTS retry succeeded")
                                onReady?.invoke()
                            } else {
                                Log.e(TAG, "TTS retry failed")
                                initFailed = true
                            }
                        }
                    })
                    
                    latch.await(3, TimeUnit.SECONDS)
                }
            } catch (e: Exception) {
                Log.e(TAG, "Exception in retryInit: ${e.message}")
            }
        }.start()
    }
    
    private fun setupLanguage() {
        tts?.let { engine ->
            // 尝试设置英语
            var result = engine.setLanguage(Locale.US)
            Log.d(TAG, "Set language US result: $result (${languageResultToString(result)})")
            
            if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
                result = engine.setLanguage(Locale.UK)
                Log.d(TAG, "Set language UK result: $result (${languageResultToString(result)})")
            }
            
            if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
                result = engine.setLanguage(Locale.ENGLISH)
                Log.d(TAG, "Set language ENGLISH result: $result (${languageResultToString(result)})")
            }
            
            // 设置语速
            engine.setSpeechRate(0.9f)
            
            // 设置监听器
            engine.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                override fun onStart(utteranceId: String?) {
                    Log.d(TAG, "TTS started: $utteranceId")
                }
                override fun onDone(utteranceId: String?) {
                    Log.d(TAG, "TTS done: $utteranceId")
                }
                override fun onError(utteranceId: String?) {
                    Log.e(TAG, "TTS error: $utteranceId")
                }
                override fun onError(utteranceId: String?, errorCode: Int) {
                    Log.e(TAG, "TTS error: $utteranceId, code: $errorCode")
                }
            })
        }
    }
    
    private fun languageResultToString(result: Int): String {
        return when (result) {
            TextToSpeech.LANG_AVAILABLE -> "LANG_AVAILABLE"
            TextToSpeech.LANG_COUNTRY_AVAILABLE -> "LANG_COUNTRY_AVAILABLE"
            TextToSpeech.LANG_COUNTRY_VAR_AVAILABLE -> "LANG_COUNTRY_VAR_AVAILABLE"
            TextToSpeech.LANG_MISSING_DATA -> "LANG_MISSING_DATA"
            TextToSpeech.LANG_NOT_SUPPORTED -> "LANG_NOT_SUPPORTED"
            else -> "UNKNOWN($result)"
        }
    }
    
    /**
     * 朗读单词
     */
    fun speak(word: String) {
        Log.d(TAG, "speak() called: $word, isInitialized=$isInitialized, initFailed=$initFailed")
        
        if (!isInitialized || tts == null) {
            Log.w(TAG, "TTS not ready, attempting reinitialization...")
            applicationContext?.let { ctx ->
                Thread {
                    initInternal(ctx) {
                        doSpeak(word)
                    }
                }.start()
            }
            return
        }
        
        doSpeak(word)
    }
    
    private fun doSpeak(word: String) {
        val engine = tts
        if (engine == null) {
            Log.e(TAG, "TTS engine is null")
            return
        }
        
        if (!isInitialized) {
            Log.e(TAG, "TTS not initialized")
            return
        }
        
        try {
            engine.stop()
            val utteranceId = "word_${System.currentTimeMillis()}"
            Log.d(TAG, "Calling speak() for: $word")
            val result = engine.speak(word, TextToSpeech.QUEUE_FLUSH, null, utteranceId)
            Log.d(TAG, "speak() result: $result (${if (result == 0) "SUCCESS" else "ERROR"})")
        } catch (e: Exception) {
            Log.e(TAG, "Exception in speak: ${e.message}")
        }
    }
    
    /**
     * 停止朗读
     */
    fun stop() {
        tts?.stop()
    }
    
    /**
     * 释放资源
     */
    @Synchronized
    fun shutdown() {
        try {
            tts?.stop()
            tts?.shutdown()
        } catch (e: Exception) {
            Log.e(TAG, "Error shutting down TTS: ${e.message}")
        }
        tts = null
        isInitialized = false
        initFailed = false
    }
    
    /**
     * 检查TTS数据是否可用
     */
    fun checkTtsData(context: Context): Boolean {
        val intent = TextToSpeech.Engine.ACTION_CHECK_TTS_DATA
        // 这个需要Activity来处理，这里只返回是否初始化成功
        return isInitialized
    }
    
    /**
     * 获取TTS状态
     */
    fun isReady(): Boolean = isInitialized && tts != null
}