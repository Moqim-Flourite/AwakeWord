package com.worddraft.data.model

import androidx.room.Entity
import androidx.room.PrimaryKey

/**
 * 单词实体类
 * @param id 主键
 * @param spelling 单词拼写
 * @param phonetic 音标
 * @param meaning 中文意思
 * @param note 用户备注
 * @param isChecked 是否已勾选（记住）
 * @param createdAt 创建时间
 * @param displayOrder 显示顺序
 */
@Entity(tableName = "words")
data class Word(
    @PrimaryKey(autoGenerate = true)
    val id: Long = 0,
    val spelling: String,
    val phonetic: String = "",
    val meaning: String = "",
    val note: String = "",
    val isChecked: Boolean = false,
    val createdAt: Long = System.currentTimeMillis(),
    val displayOrder: Int = 0
)

/**
 * 单词批次（按日期分组）
 * @param date 日期字符串 (格式: "yyyy-MM-dd")
 * @param timestamp 该日期的起始时间戳
 * @param totalCount 总单词数
 * @param uncheckedCount 未复习数
 */
data class WordBatch(
    val date: String,
    val timestamp: Long,
    val totalCount: Int,
    val uncheckedCount: Int
)

/**
 * 年份统计
 * @param year 年份
 * @param timestamp 该年起始时间戳
 * @param totalCount 总单词数
 * @param uncheckedCount 未复习数
 */
data class WordYear(
    val year: Int,
    val timestamp: Long,
    val totalCount: Int,
    val uncheckedCount: Int
)

/**
 * 月份统计
 * @param year 年份
 * @param month 月份 (1-12)
 * @param timestamp 该月起始时间戳
 * @param totalCount 总单词数
 * @param uncheckedCount 未复习数
 */
data class WordMonth(
    val year: Int,
    val month: Int,
    val timestamp: Long,
    val totalCount: Int,
    val uncheckedCount: Int
)

/**
 * 周统计
 * @param year 年份
 * @param month 月份 (1-12)
 * @param weekOfMonth 月内周数 (1-5)
 * @param timestamp 该周起始时间戳
 * @param totalCount 总单词数
 * @param uncheckedCount 未复习数
 */
data class WordWeek(
    val year: Int,
    val month: Int,
    val weekOfMonth: Int,
    val timestamp: Long,
    val totalCount: Int,
    val uncheckedCount: Int
)

/**
 * 时间层级枚举
 */
enum class TimeLevel {
    YEAR, MONTH, WEEK, DAY
}
