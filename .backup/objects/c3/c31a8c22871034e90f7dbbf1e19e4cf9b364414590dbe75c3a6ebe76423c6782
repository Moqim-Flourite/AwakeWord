/**
 * 主界面
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun MainScreen(
    viewModel: MainViewModel = viewModel(),
    onNavigateToLockScreen: () -> Unit = {},
    onNavigateToWordList: () -> Unit = {}
) {
    val context = LocalContext.current
    val currentPageWords by viewModel.currentPageWords.collectAsState()
    val totalCount by viewModel.totalCount.collectAsState()
    val uncheckedCount by viewModel.uncheckedCount.collectAsState()
    val importState by viewModel.importState.collectAsState()
    
    var showImportDialog by remember { mutableStateOf(false) }
    var showMenu by remember { mutableStateOf(false) }
    var showPermissionDialog by remember { mutableStateOf(false) }
    var lockScreenServiceEnabled by remember { mutableStateOf(LockScreenService.isServiceEnabled(context)) }
    
    // 初始化TTS
    LaunchedEffect(Unit) {
        TtsManager.init(context)
    }
    
    // 监听服务状态变化
    LaunchedEffect(lockScreenServiceEnabled) {
        // 可以在这里检查服务实际运行状态
    }
    
    // 切换锁屏服务的函数
    val toggleLockScreenService: () -> Unit = {
        val intent = Intent(context, LockScreenService::class.java).apply {
            action = LockScreenService.ACTION_TOGGLE
        }
        if (lockScreenServiceEnabled) {
            // 停止服务
            context.stopService(intent)
            lockScreenServiceEnabled = false
            Toast.makeText(context, "锁屏服务已关闭", Toast.LENGTH_SHORT).show()
        } else {
            // 启动服务
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                context.startForegroundService(intent)
            } else {
                context.startService(intent)
            }
            lockScreenServiceEnabled = true
            // 显示权限引导对话框
            showPermissionDialog = true
        }
    }
    
    // 打开小米自启动设置
    val openAutoStartSettings: () -> Unit = {
        try {
            // 小米自启动设置
            val intent = Intent().apply {
                action = "miui.intent.action.OP_AUTO_START"
                addCategory(Intent.CATEGORY_DEFAULT)
            }
            context.startActivity(intent)
        } catch (e: Exception) {
            // 如果小米设置打开失败，尝试打开应用详情页
            try {
                val intent = Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                    data = Uri.parse("package:${context.packageName}")
                }
                context.startActivity(intent)
            } catch (e2: Exception) {
                Toast.makeText(context, "无法打开设置页面", Toast.LENGTH_SHORT).show()
            }
        }
    }
    
    Scaffold(
        topBar = {
            TopAppBar(
                title = { 
                    Text("单词草稿本") 
                },
                colors = TopAppBarDefaults.topAppBarColors(
                    containerColor = MaterialTheme.colorScheme.background,
                    titleContentColor = MaterialTheme.colorScheme.onBackground
                ),
                actions = {
                    // 锁屏模式按钮
                    IconButton(onClick = onNavigateToLockScreen) {
                        Icon(
                            imageVector = Icons.Rounded.Lock,
                            contentDescription = "锁屏模式"
                        )
                    }
                    // 更多菜单
                    Box {
                        IconButton(onClick = { showMenu = true }) {
                            Icon(
                                imageVector = Icons.Rounded.MoreVert,
                                contentDescription = "更多"
                            )
                        }
                        DropdownMenu(
                            expanded = showMenu,
                            onDismissRequest = { showMenu = false }
                        ) {
                            // 锁屏服务开关
                            DropdownMenuItem(
                                text = { 
                                    Row(
                                        verticalAlignment = Alignment.CenterVertically,
                                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                                    ) {
                                        Icon(
                                            if (lockScreenServiceEnabled) Icons.Rounded.Lock else Icons.Rounded.LockOpen,
                                            contentDescription = null
                                        )
                                        Text(if (lockScreenServiceEnabled) "关闭锁屏服务" else "开启锁屏服务")
                                    }
                                },
                                onClick = {
                                    showMenu = false
                                    toggleLockScreenService()
                                }
                            )
                            HorizontalDivider()
                            DropdownMenuItem(
                                text = { Text("查看全部单词") },
                                onClick = {
                                    showMenu = false
                                    onNavigateToWordList()
                                },
                                leadingIcon = {
                                    Icon(Icons.Rounded.List, null)
                                }
                            )
                            DropdownMenuItem(
                                text = { Text("重置所有进度") },
                                onClick = {
                                    showMenu = false
                                    viewModel.resetAllChecked()
                                    Toast.makeText(context, "已重置所有单词", Toast.LENGTH_SHORT).show()
                                },
                                leadingIcon = {
                                    Icon(Icons.Rounded.Refresh, null)
                                }
                            )
                            DropdownMenuItem(
                                text = { Text("清空所有单词") },
                                onClick = {
                                    showMenu = false
                                    viewModel.deleteAll()
                                    Toast.makeText(context, "已清空所有单词", Toast.LENGTH_SHORT).show()
                                },
                                leadingIcon = {
                                    Icon(Icons.Rounded.Delete, null)
                                }
                            )
                        }
                    }
                }
            )
        },
        floatingActionButton = {
            FloatingActionButton(
                onClick = { showImportDialog = true },
                containerColor = Primary
            ) {
                Icon(
                    imageVector = Icons.Rounded.Add,
                    contentDescription = "添加单词",
                    tint = MaterialTheme.colorScheme.onPrimary
                )
            }
        }
    ) { paddingValues ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(paddingValues)
                .padding(horizontal = 16.dp)
        ) {
            // 统计信息卡片
            Card(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(vertical = 8.dp),
                colors = CardDefaults.cardColors(
                    containerColor = MaterialTheme.colorScheme.surface
                )
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.SpaceEvenly
                ) {
                    StatItem(
                        label = "总单词",
                        value = totalCount.toString(),
                        color = Primary
                    )
                    StatItem(
                        label = "待复习",
                        value = uncheckedCount.toString(),
                        color = Secondary
                    )
                    StatItem(
                        label = "已掌握",
                        value = (totalCount - uncheckedCount).toString(),
                        color = Success
                    )
                }
            }
            
            // 当前页面单词列表
            if (currentPageWords.isEmpty()) {
                // 空状态
                Box(
                    modifier = Modifier
                        .fillMaxSize()
                        .weight(1f),
                    contentAlignment = Alignment.Center
                ) {
                    Column(
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        Icon(
                            imageVector = Icons.Rounded.MenuBook,
                            contentDescription = null,
                            modifier = Modifier.size(80.dp),
                            tint = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.3f)
                        )
                        Spacer(modifier = Modifier.height(16.dp))
                        Text(
                            text = "还没有单词",
                            style = MaterialTheme.typography.headlineSmall,
                            color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.5f)
                        )
                        Spacer(modifier = Modifier.height(8.dp))
                        Text(
                            text = "点击右下角按钮添加单词",
                            style = MaterialTheme.typography.bodyMedium,
                            color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.3f)
                        )
                    }
                }
            } else {
                LazyColumn(
                    modifier = Modifier
                        .fillMaxSize()
                        .weight(1f),
                    verticalArrangement = Arrangement.spacedBy(12.dp),
                    contentPadding = PaddingValues(vertical = 8.dp)
                ) {
                    items(
                        items = currentPageWords,
                        key = { it.id }
                    ) { word ->
                        WordCard(
                            word = word,
                            onSpeak = { TtsManager.speak(word.spelling) },
                            onCheckChange = { isChecked ->
                                if (isChecked) {
                                    viewModel.checkWord(word)
                                } else {
                                    viewModel.uncheckWord(word)
                                }
                            },
                            onNoteChange = { note ->
                                viewModel.updateNote(word, note)
                            }
                        )
                    }
                }
            }
        }
    }
    
    // 导入对话框
    if (showImportDialog) {
        ImportDialog(
            importState = importState,
            onDismiss = {
                showImportDialog = false
                viewModel.resetImportState()
            },
            onImport = { input ->
                viewModel.importWords(input)
            }
        )
    }
    
    // 权限引导对话框
    if (showPermissionDialog) {
        AlertDialog(
            onDismissRequest = { showPermissionDialog = false },
            icon = { 
                Icon(
                    imageVector = Icons.Rounded.Settings,
                    contentDescription = null,
                    modifier = Modifier.size(48.dp),
                    tint = Primary
                )
            },
            title = { 
                Text("锁屏服务已开启")
            },
            text = {
                Column {
                    Text(
                        text = "为确保亮屏自动弹出功能正常工作，请进行以下设置：",
                        style = MaterialTheme.typography.bodyMedium
                    )
                    Spacer(modifier = Modifier.height(12.dp))
                    
                    // 自启动权限
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.surfaceVariant
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(12.dp)
                        ) {
                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                Icon(
                                    imageVector = Icons.Rounded.CheckCircle,
                                    contentDescription = null,
                                    tint = Success,
                                    modifier = Modifier.size(20.dp)
                                )
                                Text(
                                    text = "1. 允许自启动",
                                    style = MaterialTheme.typography.titleSmall
                                )
                            }
                            Spacer(modifier = Modifier.height(4.dp))
                            Text(
                                text = "小米手机：设置 → 应用设置 → 应用管理 → 单词草稿本 → 自启动",
                                style = MaterialTheme.typography.bodySmall,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                    
                    Spacer(modifier = Modifier.height(8.dp))
                    
                    // 通知权限
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.surfaceVariant
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(12.dp)
                        ) {
                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                Icon(
                                    imageVector = Icons.Rounded.CheckCircle,
                                    contentDescription = null,
                                    tint = Success,
                                    modifier = Modifier.size(20.dp)
                                )
                                Text(
                                    text = "2. 允许后台运行",
                                    style = MaterialTheme.typography.titleSmall
                                )
                            }
                            Spacer(modifier = Modifier.height(4.dp))
                            Text(
                                text = "确保通知栏显示"锁屏服务运行中"",
                                style = MaterialTheme.typography.bodySmall,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                    
                    Spacer(modifier = Modifier.height(8.dp))
                    
                    // 省电策略
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.surfaceVariant
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(12.dp)
                        ) {
                            Row(
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                Icon(
                                    imageVector = Icons.Rounded.CheckCircle,
                                    contentDescription = null,
                                    tint = Success,
                                    modifier = Modifier.size(20.dp)
                                )
                                Text(
                                    text = "3. 无限制省电策略",
                                    style = MaterialTheme.typography.titleSmall
                                )
                            }
                            Spacer(modifier = Modifier.height(4.dp))
                            Text(
                                text = "设置 → 电池 → 电池优化 → 单词草稿本 → 不限制",
                                style = MaterialTheme.typography.bodySmall,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                    }
                    
                    Spacer(modifier = Modifier.height(12.dp))
                    
                    Text(
                        text = "💡 完成设置后，每次亮屏都会自动显示单词卡片",
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.primary
                    )
                }
            },
            confirmButton = {
                Button(onClick = {
                    showPermissionDialog = false
                    openAutoStartSettings()
                }) {
                    Text("去设置")
                }
            },
            dismissButton = {
                TextButton(onClick = { showPermissionDialog = false }) {
                    Text("稍后再说")
                }
            }
        )
    }
}

@Composable
fun StatItem(
    label: String,
    value: String,
    color: androidx.compose.ui.graphics.Color
) {
    Column(
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            text = value,
            style = MaterialTheme.typography.headlineMedium,
            color = color
        )
        Text(
            text = label,
            style = MaterialTheme.typography.labelMedium,
            color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.6f)
        )
    }
}

@Composable
fun ImportDialog(
    importState: ImportState,
    onDismiss: () -> Unit,
    onImport: (String) -> Unit
) {
    var inputText by remember { mutableStateOf("") }
    
    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("导入单词") },
        text = {
            when (importState) {
                is ImportState.Idle -> {
                    Column {
                        Text(
                            text = "请输入单词，用英文逗号分隔",
                            style = MaterialTheme.typography.bodyMedium,
                            modifier = Modifier.padding(bottom = 8.dp)
                        )
                        OutlinedTextField(
                            value = inputText,
                            onValueChange = { inputText = it },
                            placeholder = { Text("apple, banana, computer") },
                            modifier = Modifier
                                .fillMaxWidth()
                                .heightIn(min = 120.dp),
                            maxLines = 5
                        )
                    }
                }
                is ImportState.Loading -> {
                    Column(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalAlignment = Alignment.CenterHorizontally
                    ) {
                        CircularProgressIndicator()
                        Spacer(modifier = Modifier.height(16.dp))
                        Text("正在导入 ${importState.count} 个单词...")
                    }
                }
                is ImportState.Success -> {
                    Column {
                        Text(
                            text = "导入完成！",
                            style = MaterialTheme.typography.titleMedium,
                            color = Success
                        )
                        Spacer(modifier = Modifier.height(8.dp))
                        Text("总计: ${importState.total} 个")
                        Text("成功: ${importState.imported} 个")
                        if (importState.skipped > 0) {
                            Text("跳过(已存在): ${importState.skipped} 个")
                        }
                    }
                }
                is ImportState.Error -> {
                    Text(
                        text = importState.message,
                        color = MaterialTheme.colorScheme.error
                    )
                }
            }
        },
        confirmButton = {
            when (importState) {
                is ImportState.Idle -> {
                    Button(
                        onClick = { onImport(inputText) },
                        enabled = inputText.isNotBlank()
                    ) {
                        Text("导入")
                    }
                }
                is ImportState.Success, is ImportState.Error -> {
                    Button(onClick = onDismiss) {
                        Text("确定")
                    }
                }
                else -> {}
            }
        },
        dismissButton = {
            if (importState is ImportState.Idle) {
                TextButton(onClick = onDismiss) {
                    Text("取消")
                }
            }
        }
    )
}