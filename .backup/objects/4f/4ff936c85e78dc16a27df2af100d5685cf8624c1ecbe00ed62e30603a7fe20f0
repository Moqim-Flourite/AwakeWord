package com.worddraft.data.local

import androidx.room.*
import com.worddraft.data.model.Word
import com.worddraft.data.model.WordBatch
import com.worddraft.data.model.WordYear
import com.worddraft.data.model.WordMonth
import com.worddraft.data.model.WordWeek
import kotlinx.coroutines.flow.Flow

@Dao
interface WordDao {
    
    /**
     * 获取所有未勾选的单词（按显示顺序）
     */
    @Query("SELECT * FROM words WHERE isChecked = 0 ORDER BY displayOrder ASC, createdAt DESC")
    fun getUncheckedWords(): Flow<List<Word>>
    
    /**
     * 获取所有未勾选的单词（一次性查询，非Flow）
     */
    @Query("SELECT * FROM words WHERE isChecked = 0 ORDER BY displayOrder ASC, createdAt ASC")
    suspend fun getUncheckedWordsOnce(): List<Word>
    
    /**
     * 获取所有单词（按显示顺序）
     */
    @Query("SELECT * FROM words ORDER BY displayOrder ASC, createdAt DESC")
    fun getAllWords(): Flow<List<Word>>
    
    /**
     * 获取当前显示页面的单词（最多5个，按原始顺序）
     * 只获取未勾选的单词，勾选后单词从当前页移除
     */
    @Query("SELECT * FROM words WHERE isChecked = 0 ORDER BY displayOrder ASC, createdAt ASC LIMIT 5")
    fun getCurrentPageWords(): Flow<List<Word>>
    
    /**
     * 获取未勾选单词数量
     */
    @Query("SELECT COUNT(*) FROM words WHERE isChecked = 0")
    fun getUncheckedCount(): Flow<Int>
    
    /**
     * 获取总单词数量
     */
    @Query("SELECT COUNT(*) FROM words")
    fun getTotalCount(): Flow<Int>
    
    /**
     * 插入单词
     */
    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertWord(word: Word): Long
    
    /**
     * 批量插入单词
     */
    @Insert(onConflict = OnConflictStrategy.REPLACE)
    suspend fun insertWords(words: List<Word>)
    
    /**
     * 更新单词
     */
    @Update
    suspend fun updateWord(word: Word)
    
    /**
     * 删除单词
     */
    @Delete
    suspend fun deleteWord(word: Word)
    
    /**
     * 根据ID获取单词
     */
    @Query("SELECT * FROM words WHERE id = :wordId")
    suspend fun getWordById(wordId: Long): Word?
    
    /**
     * 检查单词是否已存在
     */
    @Query("SELECT EXISTS(SELECT 1 FROM words WHERE spelling = :spelling COLLATE NOCASE)")
    suspend fun isWordExists(spelling: String): Boolean
    
    /**
     * 将单词移到队列末尾（设置最大的displayOrder）
     */
    @Query("UPDATE words SET displayOrder = (SELECT COALESCE(MAX(displayOrder), 0) + 1 FROM words) WHERE id = :wordId")
    suspend fun moveToEnd(wordId: Long)
    
    /**
     * 清空所有单词
     */
    @Query("DELETE FROM words")
    suspend fun deleteAll()
    
    /**
     * 重置所有单词的勾选状态
     */
    @Query("UPDATE words SET isChecked = 0")
    suspend fun resetAllChecked()
    
    /**
     * 获取指定日期范围内的单词（按日期查询）
     * @param startTime 当天起始时间戳
     * @param endTime 当天结束时间戳
     */
    @Query("SELECT * FROM words WHERE createdAt >= :startTime AND createdAt < :endTime ORDER BY createdAt DESC")
    fun getWordsByDateRange(startTime: Long, endTime: Long): Flow<List<Word>>
    
    /**
     * 获取指定日期范围内的单词（一次性查询）
     */
    @Query("SELECT * FROM words WHERE createdAt >= :startTime AND createdAt < :endTime ORDER BY createdAt DESC")
    suspend fun getWordsByDateRangeOnce(startTime: Long, endTime: Long): List<Word>
    
    /**
     * 获取所有单词按日期分组统计
     * 返回每个日期的总数和未勾选数
     */
    @Query("""
        SELECT 
            date(createdAt / 1000, 'unixepoch', 'localtime') as date,
            MIN(createdAt) as timestamp,
            COUNT(*) as totalCount,
            SUM(CASE WHEN isChecked = 0 THEN 1 ELSE 0 END) as uncheckedCount
        FROM words
        GROUP BY date
        ORDER BY timestamp DESC
    """)
    fun getBatches(): Flow<List<WordBatch>>
    
    /**
     * 获取所有单词按年份分组统计
     */
    @Query("""
        SELECT 
            CAST(strftime('%Y', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) as year,
            MIN(createdAt) as timestamp,
            COUNT(*) as totalCount,
            SUM(CASE WHEN isChecked = 0 THEN 1 ELSE 0 END) as uncheckedCount
        FROM words
        GROUP BY year
        ORDER BY year DESC
    """)
    fun getYears(): Flow<List<WordYear>>
    
    /**
     * 获取指定年份的所有月份统计
     * @param yearStartTime 年份起始时间戳
     * @param yearEndTime 年份结束时间戳
     */
    @Query("""
        SELECT 
            CAST(strftime('%Y', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) as year,
            CAST(strftime('%m', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) as month,
            MIN(createdAt) as timestamp,
            COUNT(*) as totalCount,
            SUM(CASE WHEN isChecked = 0 THEN 1 ELSE 0 END) as uncheckedCount
        FROM words
        WHERE createdAt >= :yearStartTime AND createdAt < :yearEndTime
        GROUP BY year, month
        ORDER BY month DESC
    """)
    fun getMonthsByYear(yearStartTime: Long, yearEndTime: Long): Flow<List<WordMonth>>
    
    /**
     * 获取指定月份的所有周统计
     * @param monthStartTime 月份起始时间戳
     * @param monthEndTime 月份结束时间戳
     */
    @Query("""
        SELECT 
            CAST(strftime('%Y', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) as year,
            CAST(strftime('%m', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) as month,
            CAST(strftime('%W', datetime(createdAt / 1000, 'unixepoch', 'localtime')) AS INTEGER) -
            CAST(strftime('%W', datetime(:monthStartTime / 1000, 'unixepoch', 'localtime')) AS INTEGER) + 1 as weekOfMonth,
            MIN(createdAt) as timestamp,
            COUNT(*) as totalCount,
            SUM(CASE WHEN isChecked = 0 THEN 1 ELSE 0 END) as uncheckedCount
        FROM words
        WHERE createdAt >= :monthStartTime AND createdAt < :monthEndTime
        GROUP BY year, weekOfMonth
        ORDER BY weekOfMonth DESC
    """)
    fun getWeeksByMonth(monthStartTime: Long, monthEndTime: Long): Flow<List<WordWeek>>
    
    /**
     * 获取指定日期范围内的批次（日）
     * @param startTime 起始时间戳
     * @param endTime 结束时间戳
     */
    @Query("""
        SELECT 
            date(createdAt / 1000, 'unixepoch', 'localtime') as date,
            MIN(createdAt) as timestamp,
            COUNT(*) as totalCount,
            SUM(CASE WHEN isChecked = 0 THEN 1 ELSE 0 END) as uncheckedCount
        FROM words
        WHERE createdAt >= :startTime AND createdAt < :endTime
        GROUP BY date
        ORDER BY timestamp DESC
    """)
    fun getBatchesByDateRange(startTime: Long, endTime: Long): Flow<List<WordBatch>>
}
