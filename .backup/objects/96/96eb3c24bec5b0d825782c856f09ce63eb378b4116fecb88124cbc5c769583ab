package com.worddraft.util

import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.net.URL
import java.net.URLEncoder

/**
 * 词典查询结果
 */
data class DictResult(
    val phonetic: String,
    val meaning: String
)

/**
 * 词典API工具类
 * 使用免费词典API获取单词音标和中文意思
 */
object DictionaryApi {
    
    /**
     * 查询单词
     * 优先使用有道词典API，失败则返回空
     */
    suspend fun lookup(word: String): DictResult? = withContext(Dispatchers.IO) {
        try {
            // 使用有道词典API
            val encodedWord = URLEncoder.encode(word, "UTF-8")
            val url = "https://dict.youdao.com/suggest?num=1&doctype=json&q=$encodedWord"
            
            val response = URL(url).readText()
            parseYoudaoResponse(response, word)
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }
    
    /**
     * 解析有道词典响应
     */
    private fun parseYoudaoResponse(response: String, word: String): DictResult? {
        return try {
            val json = JSONObject(response)
            
            // 检查是否有数据
            if (!json.has("data") || json.isNull("data")) {
                return null
            }
            
            val data = json.getJSONObject("data")
            
            if (!data.has("entries") || data.isNull("entries")) {
                return null
            }
            
            val entries = data.getJSONArray("entries")
            if (entries.length() == 0) {
                return null
            }
            
            val entry = entries.getJSONObject(0)
            val meaning = entry.optString("explain", "")
            val spelling = entry.optString("entry", "")
            
            // 提取音标（如果有的话）
            val phonetic = extractPhonetic(meaning)
            
            DictResult(
                phonetic = phonetic,
                meaning = cleanMeaning(meaning)
            )
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }
    
    /**
     * 从释义中提取音标
     */
    private fun extractPhonetic(meaning: String): String {
        // 尝试匹配音标格式，如 [ˈwɜːrd] 或 /wɜːrd/
        val phoneticRegex = Regex("""\[([^\]]+)\]|/([^/]+)/""")
        val match = phoneticRegex.find(meaning)
        return match?.let { 
            it.groupValues[1].ifEmpty { it.groupValues[2] }
        } ?: ""
    }
    
    /**
     * 清理释义文本
     */
    private fun cleanMeaning(meaning: String): String {
        // 移除音标部分
        var cleaned = meaning
            .replace(Regex("""\[[^\]]+\]"""), "")
            .replace(Regex("""/[^/]+/"""), "")
            .trim()
        
        // 如果包含中文，提取中文部分
        val chineseRegex = Regex("""[\u4e00-\u9fa5，。、；：！？""''（）【】《》\s]+""")
        val chineseMatch = chineseRegex.findAll(cleaned).joinToString("") { it.value }
        
        return chineseMatch.ifEmpty { cleaned }.trim()
    }
}