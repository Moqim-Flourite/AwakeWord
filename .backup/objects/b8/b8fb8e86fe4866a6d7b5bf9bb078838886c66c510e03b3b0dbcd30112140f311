package com.worddraft.viewmodel

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.worddraft.data.model.Word
import com.worddraft.data.repository.WordRepository
import com.worddraft.util.DictionaryApi
import kotlinx.coroutines.flow.*
import kotlinx.coroutines.launch

/**
 * 主界面 ViewModel
 * 管理单词列表和勾选逻辑
 */
class MainViewModel(
    private val repository: WordRepository
) : ViewModel() {
    
    // 当前显示的单词（最多8个，未勾选在前，已勾选在后）
    val currentPageWords: StateFlow<List<Word>> = repository.getCurrentPageWords()
        .stateIn(viewModelScope, SharingStarted.Lazily, emptyList())
    
    // 所有单词
    val allWords: StateFlow<List<Word>> = repository.getAllWords()
        .stateIn(viewModelScope, SharingStarted.Lazily, emptyList())
    
    // 未勾选单词数量
    val uncheckedCount: StateFlow<Int> = repository.getUncheckedCount()
        .stateIn(viewModelScope, SharingStarted.Lazily, 0)
    
    // 总单词数量
    val totalCount: StateFlow<Int> = repository.getTotalCount()
        .stateIn(viewModelScope, SharingStarted.Lazily, 0)
    
    // 导入状态
    private val _importState = MutableStateFlow<ImportState>(ImportState.Idle)
    val importState: StateFlow<ImportState> = _importState.asStateFlow()
    
    // 当前页是否全部勾选完成
    val isCurrentPageComplete: StateFlow<Boolean> = currentPageWords
        .map { words -> words.isNotEmpty() && words.all { it.isChecked } }
        .stateIn(viewModelScope, SharingStarted.Lazily, false)
    
    /**
     * 导入单词（英文逗号分隔）
     */
    fun importWords(input: String) {
        val words = input.split(",")
            .map { it.trim() }
            .filter { it.isNotBlank() }
        
        if (words.isEmpty()) {
            _importState.value = ImportState.Error("请输入有效的单词")
            return
        }
        
        viewModelScope.launch {
            _importState.value = ImportState.Loading(words.size)
            
            val wordList = mutableListOf<Word>()
            var successCount = 0
            var skipCount = 0
            
            words.forEach { spelling ->
                // 检查是否已存在
                if (repository.isWordExists(spelling)) {
                    skipCount++
                    return@forEach
                }
                
                // 尝试从词典API获取信息
                val dictResult = DictionaryApi.lookup(spelling)
                
                wordList.add(
                    Word(
                        spelling = spelling,
                        phonetic = dictResult?.phonetic ?: "",
                        meaning = dictResult?.meaning ?: ""
                    )
                )
                successCount++
            }
            
            if (wordList.isNotEmpty()) {
                repository.insertWords(wordList)
            }
            
            _importState.value = ImportState.Success(
                total = words.size,
                imported = successCount,
                skipped = skipCount
            )
        }
    }
    
    /**
     * 勾选单词（移到当前页末尾）
     */
    fun checkWord(word: Word) {
        viewModelScope.launch {
            // 先更新勾选状态
            repository.updateWord(word.copy(isChecked = true))
            // 移到队尾（设置最大的 displayOrder）
            repository.moveToEnd(word.id)
        }
    }
    
    /**
     * 取消勾选
     */
    fun uncheckWord(word: Word) {
        viewModelScope.launch {
            repository.updateWord(word.copy(isChecked = false))
        }
    }
    
    /**
     * 更新单词备注
     */
    fun updateNote(word: Word, note: String) {
        viewModelScope.launch {
            repository.updateWord(word.copy(note = note))
        }
    }
    
    /**
     * 更新单词完整信息
     */
    fun updateWord(word: Word) {
        viewModelScope.launch {
            repository.updateWord(word)
        }
    }
    
    /**
     * 删除单词
     */
    fun deleteWord(word: Word) {
        viewModelScope.launch {
            repository.deleteWord(word)
        }
    }
    
    /**
     * 重置导入状态
     */
    fun resetImportState() {
        _importState.value = ImportState.Idle
    }
    
    /**
     * 重置所有勾选状态（用于重新开始复习）
     */
    fun resetAllChecked() {
        viewModelScope.launch {
            repository.resetAllChecked()
        }
    }
    
    /**
     * 刷新到下一页（当当前页全部勾选后调用）
     * 将当前页的已勾选单词移到队尾，新单词自然进入当前页
     */
    fun refreshToNextPage() {
        viewModelScope.launch {
            // 当前页单词已经全部勾选并移到末尾了
            // 无需额外操作，下一页会自动显示新的未勾选单词
            // 只需要确保 displayOrder 正确即可
        }
    }
    
    /**
     * 清空所有单词
     */
    fun deleteAll() {
        viewModelScope.launch {
            repository.deleteAll()
        }
    }
}

/**
 * 导入状态
 */
sealed class ImportState {
    object Idle : ImportState()
    data class Loading(val count: Int) : ImportState()
    data class Success(
        val total: Int,
        val imported: Int,
        val skipped: Int
    ) : ImportState()
    data class Error(val message: String) : ImportState()
}