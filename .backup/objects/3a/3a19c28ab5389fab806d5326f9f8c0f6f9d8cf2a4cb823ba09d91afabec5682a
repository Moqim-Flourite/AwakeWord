package com.worddraft

import android.Manifest
import android.app.KeyguardManager
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.os.PowerManager
import android.provider.Settings
import android.widget.Toast
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.activity.result.contract.ActivityResultContracts
import androidx.compose.animation.AnimatedContentTransitionScope
import androidx.compose.animation.core.tween
import androidx.compose.runtime.*
import androidx.compose.ui.platform.LocalContext
import androidx.core.content.ContextCompat
import androidx.lifecycle.viewmodel.compose.viewModel
import androidx.navigation.NavHostController
import androidx.navigation.NavType
import androidx.navigation.compose.NavHost
import androidx.navigation.compose.composable
import androidx.navigation.compose.rememberNavController
import androidx.navigation.navArgument
import com.worddraft.ui.screens.BatchDetailScreen
import com.worddraft.ui.screens.MainScreen
import com.worddraft.ui.screens.WordListScreen
import com.worddraft.ui.theme.WordDraftTheme
import com.worddraft.ui.theme.shouldUseDarkTheme
import com.worddraft.viewmodel.MainViewModel
import com.worddraft.util.ThemeManager
import com.worddraft.util.ThemeMode
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.runBlocking

class MainActivity : ComponentActivity() {
    
    companion object {
        private const val REQUEST_CODE_SYSTEM_ALERT_WINDOW = 1001
    }
    
    private var isLaunchLockScreen = false
    
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()
        
        setContent {
            // 获取当前主题模式
            val context = LocalContext.current
            val themeMode by ThemeManager.getThemeMode(context).collectAsState(
                initial = ThemeMode.FOLLOW_SYSTEM
            )
            val darkTheme = shouldUseDarkTheme(themeMode)
            
            WordDraftTheme(darkTheme = darkTheme) {
                val navController = rememberNavController()
                val viewModel: MainViewModel = viewModel(
                    factory = WordDraftApplication.viewModelFactory
                )
                
                // 监听锁屏启动请求
                LaunchedEffect(Unit) {
                    if (isLaunchLockScreen) {
                        isLaunchLockScreen = false
                        startLockScreenActivity()
                    }
                }
                
                NavHost(
                    navController = navController,
                    startDestination = "main"
                ) {
                    composable(
                        route = "main",
                        exitTransition = {
                            slideOutOfContainer(
                                AnimatedContentTransitionScope.SlideDirection.Left,
                                animationSpec = tween(300)
                            )
                        },
                        popEnterTransition = {
                            slideIntoContainer(
                                AnimatedContentTransitionScope.SlideDirection.Right,
                                animationSpec = tween(300)
                            )
                        }
                    ) {
                        MainScreen(
                            viewModel = viewModel,
                            onNavigateToLockScreen = {
                                // 检查权限并启动锁屏
                                checkAndStartLockScreen()
                            },
                            onNavigateToWordList = {
                                navController.navigate("list")
                            },
                            onNavigateToBatch = { timestamp ->
                                navController.navigate("batch/$timestamp")
                            }
                        )
                    }
                    
                    composable(
                        route = "list",
                        enterTransition = {
                            slideIntoContainer(
                                AnimatedContentTransitionScope.SlideDirection.Left,
                                animationSpec = tween(300)
                            )
                        },
                        exitTransition = {
                            slideOutOfContainer(
                                AnimatedContentTransitionScope.SlideDirection.Right,
                                animationSpec = tween(300)
                            )
                        }
                    ) {
                        WordListScreen(
                            viewModel = viewModel,
                            onBack = {
                                navController.popBackStack()
                            }
                        )
                    }
                    
                    composable(
                        route = "batch/{timestamp}",
                        arguments = listOf(
                            navArgument("timestamp") { type = NavType.LongType }
                        ),
                        enterTransition = {
                            slideIntoContainer(
                                AnimatedContentTransitionScope.SlideDirection.Left,
                                animationSpec = tween(300)
                            )
                        },
                        exitTransition = {
                            slideOutOfContainer(
                                AnimatedContentTransitionScope.SlideDirection.Right,
                                animationSpec = tween(300)
                            )
                        }
                    ) { backStackEntry ->
                        val timestamp = backStackEntry.arguments?.getLong("timestamp") ?: 0L
                        BatchDetailScreen(
                            viewModel = viewModel,
                            dateTimestamp = timestamp,
                            onBack = {
                                navController.popBackStack()
                            }
                        )
                    }
                }
            }
        }
    }
    
    private fun checkAndStartLockScreen() {
        // 1. 先检查悬浮窗权限
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && !Settings.canDrawOverlays(this)) {
            Toast.makeText(
                this,
                "请开启「显示在其他应用上层」权限",
                Toast.LENGTH_LONG
            ).show()
            val intent = Intent(
                Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
                Uri.parse("package:$packageName")
            )
            startActivityForResult(intent, REQUEST_CODE_SYSTEM_ALERT_WINDOW)
            isLaunchLockScreen = true
            return
        }
        
        // 2. 检查电池优化（小米MIUI需要）
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            val pm = getSystemService(Context.POWER_SERVICE) as PowerManager
            if (!pm.isIgnoringBatteryOptimizations(packageName)) {
                Toast.makeText(
                    this,
                    "建议关闭电池优化以确保锁屏功能正常工作",
                    Toast.LENGTH_LONG
                ).show()
                try {
                    val intent = Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS).apply {
                        data = Uri.parse("package:$packageName")
                    }
                    startActivity(intent)
                } catch (e: Exception) {
                    // 某些设备可能不支持这个Intent，直接启动锁屏
                }
            }
        }
        
        // 3. 直接启动锁屏Activity
        startLockScreenActivity()
    }
    
    private fun startLockScreenActivity() {
        val intent = Intent(this, LockScreenActivity::class.java).apply {
            // 添加必要的flags
            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP)
        }
        startActivity(intent)
    }
    
    @Deprecated("Deprecated in Java")
    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
        super.onActivityResult(requestCode, resultCode, data)
        if (requestCode == REQUEST_CODE_SYSTEM_ALERT_WINDOW) {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && Settings.canDrawOverlays(this)) {
                Toast.makeText(this, "权限已获取，请再次点击锁屏按钮", Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(this, "未获取权限，锁屏功能可能无法正常工作", Toast.LENGTH_SHORT).show()
            }
        }
    }
}