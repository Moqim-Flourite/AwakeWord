package com.worddraft.util

import android.content.Context
import android.speech.tts.TextToSpeech
import android.speech.tts.UtteranceProgressListener
import java.util.*

/**
 * TTS语音工具类
 * 用于单词发音
 */
object TtsManager {
    
    private var tts: TextToSpeech? = null
    private var isInitialized = false
    private var pendingSpeech: String? = null
    
    /**
     * 初始化TTS
     */
    fun init(context: Context, onReady: (() -> Unit)? = null) {
        if (tts != null) {
            if (isInitialized) onReady?.invoke()
            return
        }
        
        tts = TextToSpeech(context.applicationContext) { status ->
            if (status == TextToSpeech.SUCCESS) {
                // 尝试设置英语发音
                val result = tts?.setLanguage(Locale.US)
                
                // 设置语速
                tts?.setSpeechRate(0.9f)
                
                // 设置进度监听
                tts?.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                    override fun onStart(utteranceId: String?) {}
                    override fun onDone(utteranceId: String?) {}
                    override fun onError(utteranceId: String?) {}
                })
                
                isInitialized = true
                onReady?.invoke()
                
                // 处理等待中的语音
                pendingSpeech?.let {
                    speakInternal(it)
                    pendingSpeech = null
                }
            } else {
                // 初始化失败，记录日志
                android.util.Log.e("TtsManager", "TTS initialization failed with status: $status")
            }
        }
    }
    
    /**
     * 朗读单词
     */
    fun speak(word: String) {
        if (!isInitialized || tts == null) {
            // TTS 未初始化，保存待播放的单词
            pendingSpeech = word
            return
        }
        speakInternal(word)
    }
    
    private fun speakInternal(word: String) {
        tts?.let { textToSpeech ->
            // 先停止之前的播放
            textToSpeech.stop()
            
            // 使用 Bundle 参数播放
            val params = android.os.Bundle().apply {
                putString(TextToSpeech.Engine.KEY_PARAM_UTTERANCE_ID, "word_${System.currentTimeMillis()}")
            }
            textToSpeech.speak(word, TextToSpeech.QUEUE_FLUSH, params, "word_${System.currentTimeMillis()}")
        }
    }
    
    /**
     * 停止朗读
     */
    fun stop() {
        tts?.stop()
    }
    
    /**
     * 释放资源
     */
    fun release() {
        tts?.stop()
        tts?.shutdown()
        tts = null
        isInitialized = false
        pendingSpeech = null
    }
}