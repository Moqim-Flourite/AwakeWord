<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 主应用主题 -->
    <style name="Theme.WordDraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#6B4CE0</item>
        <item name="android:colorPrimaryDark">#5038B8</item>
        <item name="android:colorAccent">#FF9800</item>
        <item name="android:statusBarColor">#1A1A2E</item>
        <item name="android:navigationBarColor">#1A1A2E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    
    <!-- 锁屏主题 -->
    <style name="Theme.WordDraft.LockScreen" parent="Theme.WordDraft">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>